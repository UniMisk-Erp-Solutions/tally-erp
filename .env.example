# Copy to .env on the server and fill in. Never commit .env.
DATABASE_URL=postgresql://tallysync_app:PASSWORD@supabase-db-XXXX:5432/postgres   # the database Supabase Studio shows
SUPABASE_NETWORK=your_coolify_supabase_network_name
BIND_ADDR=127.0.0.1

# Secrets: FERNET_KEY = 32 random bytes, url-safe base64; SECRET_KEY = long random string
FERNET_KEY=
SECRET_KEY=

# First start only: creates this login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ORG_NAME=My Company

# Free Google AI key (free-tier models only)
GEMINI_API_KEY=
AI_MODELS=gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it
AI_MIN_INTERVAL=4
DATA_DIR=/data

# Public addresses
PUBLIC_API_URL=https://tally-api.unimisk.com
STUDIO_URL=https://tally-backend.unimisk.com
# Web pages allowed to call the API ("*" = any subdomain / any port)
ALLOWED_ORIGINS=https://*.vercel.app,https://*.unimisk.com
NODE_ENV=production
